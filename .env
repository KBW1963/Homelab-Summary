# Redact sensitive information (IPs, MACs) from API responses
REDACT_IPS=true


# Polling interval in milliseconds (default: 30000)
POLL_INTERVAL_MS=30000

# Port the API listens on (default: 3000)
PORT=3333

# Log level: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info

# Aggregator API key (required for all endpoints except /health)
